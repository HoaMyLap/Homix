# ==========================================
# ENVIRONMENT & SECRETS (NEVER COMMIT)
# ==========================================
.env
.env.*
!.env.example
client/.env*
!client/.env.example
server/.env*

# ==========================================
# FRONTEND (Next.js / Node.js)
# ==========================================
**/node_modules/
**/.pnp
**/.pnp.*
**/.next/
**/out/
**/coverage/
**/.vercel/
**/*.tsbuildinfo
client/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# BACKEND (Spring Boot / Gradle / Java)
# ==========================================
server/.gradle/
server/build/
!server/gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
server/bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
server/out/
**/*.class
**/*.log
hs_err_pid*

# ==========================================
# IDEs & OS FILES
# ==========================================
.idea/
.vscode/
*.iws
*.iml
*.ipr
.project
.classpath
.settings/
.DS_Store
Thumbs.db
*.pem
